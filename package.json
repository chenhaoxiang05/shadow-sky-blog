{
  "name": "shadow-sky-blog",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/auth.test.ts tests/community.test.ts tests/database-runtime.test.ts tests/media-cleanup.test.ts tests/no-email.test.ts tests/theme-transition.test.ts tests/view-context.test.ts",
    "test:integration": "node --import tsx --test tests/posts.test.ts",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "audit:prune": "tsx scripts/prune-audit.ts",
    "media:prune": "tsx scripts/prune-media.ts",
    "owner:reset-password": "tsx scripts/reset-owner-password.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^2.0.1",
    "drizzle-orm": "0.45.2",
    "marked": "^16.4.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
